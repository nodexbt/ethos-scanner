# Copy to .env.local and fill in. Nothing here is optional unless marked.

# --- Required -------------------------------------------------------------

# Alchemy API key. One key covers every chain the scanner reads
# (Ethereum, Base, Arbitrum, Optimism, Polygon). The free tier works for
# development; heavy scans throttle on it (see docs/setup.md).
ALCHEMY_API_KEY=

# Supabase project URL and the *service role* key. The app only ever runs
# server-side against the database, so the anon key is not used anywhere.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# NextAuth. NEXTAUTH_SECRET signs the session JWT; generate one with
#   openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# X (Twitter) OAuth 2.0 app credentials. Sign-in is X-only because every
# Ethos profile is attested to an X account, which is how the app maps a
# login to an Ethos profile id. Callback URL for local dev:
#   http://localhost:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------

# Comma-separated Ethos profile ids that get the admin panel, unlimited
# scans and scanner attribution in lists.
ETHOS_ADMIN_PROFILE_IDS=

# Comma-separated Ethos profile ids that may sign in even if they do not
# meet the open access bar (human-verified + score >= 1800, or validator
# NFT). Seeds the allowed_users table on first run; the table is the
# source of truth after that.
ETHOS_PROFILE_ALLOWLIST=

# Public origin used for Open Graph metadata. Falls back to the Vercel
# production URL, then to localhost.
NEXT_PUBLIC_SITE_URL=

# X post search for twitter evidence (twitterapi.io). Off by default; the
# UI hides the feature unless the flag is "true".
NEXT_PUBLIC_TWITTER_SEARCH_ENABLED=false
TWITTERAPI_IO_KEY=
